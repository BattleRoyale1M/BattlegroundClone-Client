# ==========================================================================
#  Unreal Engine project .gitattributes
#  - Binary asset types tracked via Git LFS
#  - Text files normalised to LF, UE C++ kept as-is
# ==========================================================================

# Auto-detect text files, normalise to LF in the repo
* text=auto

# ------------------------------------------------------------------
#  Explicit text types (never LFS, keep diffable)
# ------------------------------------------------------------------
*.cpp               text
*.h                 text
*.hpp               text
*.c                 text
*.cs                text
*.ini               text
*.uproject          text
*.uplugin           text
*.py                text
*.lua               text
*.md                text
*.txt               text
*.json              text
*.xml               text
*.yml               text
*.yaml              text
*.gitattributes     text
*.gitignore         text
.editorconfig       text

# Windows-specific scripts keep CRLF
*.bat               text eol=crlf
*.cmd               text eol=crlf
*.ps1               text eol=crlf
# Unix shell scripts keep LF
*.sh                text eol=lf

# ------------------------------------------------------------------
#  Unreal binary assets  ->  Git LFS
# ------------------------------------------------------------------
*.uasset            filter=lfs diff=lfs merge=lfs -text
*.umap              filter=lfs diff=lfs merge=lfs -text
*.ubulk             filter=lfs diff=lfs merge=lfs -text
*.uexp              filter=lfs diff=lfs merge=lfs -text
*.upk               filter=lfs diff=lfs merge=lfs -text
*.udk               filter=lfs diff=lfs merge=lfs -text
*.locres            filter=lfs diff=lfs merge=lfs -text

# ------------------------------------------------------------------
#  Raw content / DCC source files  ->  Git LFS
# ------------------------------------------------------------------
# 3D
*.fbx               filter=lfs diff=lfs merge=lfs -text
*.obj               filter=lfs diff=lfs merge=lfs -text
